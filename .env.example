# 复制成 .env 后填写。.env 已被 .gitignore 忽略。
#
# 用户名必填（同时是数据库里 session 的行键）；密码只有「重新登录」时才用得到，
# 定时同步永远不会拿它去登录佳明。

# ---- 账号1 ----
GARMIN_USERNAME=
GARMIN_PASSWORD=
GARMIN_GLOBAL_USERNAME=
GARMIN_GLOBAL_PASSWORD=

# ---- 账号2 ----
GARMIN_USERNAME_2=
GARMIN_PASSWORD_2=
GARMIN_GLOBAL_USERNAME_2=
GARMIN_GLOBAL_PASSWORD_2=

# 163 邮箱 IMAP 授权码（不是登录密码），账号2 自动取验证码用
MAIL_IMAP_PASSWORD=
# 非 163 邮箱时才需要改
# MAIL_IMAP_HOST=imap.163.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_USER=

# session 加密密钥
AESKEY=

# Bark 推送 key，留空则只打日志
BARK_KEY=

# 可选：运行时数据目录，默认 ~/.dailysync
# DAILYSYNC_DATA_DIR=
