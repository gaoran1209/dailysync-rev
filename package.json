{
  "name": "garmin-daily-sync",
  "version": "2.0.0",
  "description": "把两个佳明国区账号的运动活动定时同步到各自的国际区账号（本机 launchd 运行）",
  "main": "dist/sync.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "sync": "node dist/sync.js",
    "relogin:account2": "node dist/relogin_account2.js",
    "relogin:cn": "node dist/relogin_cn.js",
    "export:global-token": "node dist/export_garmin_global_session.js",
    "import:global-token": "node dist/import_global_token.js",
    "report": "node scripts/sync-report.js"
  },
  "author": "yanzhitao",
  "license": "GPL-3.0",
  "dependencies": {
    "@gooin/garmin-connect": "1.8.7",
    "axios": "^0.24.0",
    "crypto-js": "^4.1.1",
    "decompress": "^4.2.1",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "oauth-1.0a": "^2.2.6",
    "playwright": "^1.52.0",
    "qs": "^6.10.3",
    "sqlite": "^4.1.2",
    "sqlite3": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^16.6.2",
    "typescript": "^4.3.5"
  }
}
